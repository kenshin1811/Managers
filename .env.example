# Copy to .env and edit.  Nothing here is a real credential.

# --- infrastructure ---
DATABASE_URL=sqlite:///./managers.db
BUSINESS_TZ=Australia/Melbourne
PUBLIC_BASE_URL=http://localhost:8000

# --- messaging ---
# DRY_RUN=true means no message ever leaves the process. Flip it only once the
# Slack app below is real and you have watched the dry-run output.
DRY_RUN=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_MANAGER_CHANNEL=#managers
# Signs the single-use accept/decline links in cover requests. Change it.
COVERAGE_LINK_SECRET=dev-insecure-change-me
COVERAGE_LINK_TTL_MINUTES=180

# --- autonomy switches ---
AUTO_REASSIGN_ENABLED=true
AUTO_COVERAGE_REQUESTS_ENABLED=true

# --- hard guardrails (review against local labor law before going live) ---
MAX_DAILY_HOURS=10
MAX_WEEKLY_HOURS=48
MIN_REST_HOURS=11
QUIET_HOURS_START=21
QUIET_HOURS_END=7
QUIET_HOURS_OVERRIDE_FOR_CRITICAL=true
MAX_COVERAGE_ASKS_PER_DAY=3

# --- timing ---
COVERAGE_RESPONSE_TIMEOUT_MINUTES=10
ESCALATION_LEAD_MINUTES=15
CRITICAL_PICKUP_GRACE_MINUTES=30
COVERAGE_BATCH_SIZE=3

# --- scoring weights ---
WEIGHT_CONTINUITY=40
WEIGHT_ON_SHIFT=30
WEIGHT_IDLE=20
WEIGHT_PROFICIENCY=10
WEIGHT_FAIRNESS=15
